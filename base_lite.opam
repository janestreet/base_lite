opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/base_lite"
bug-reports: "https://github.com/janestreet/base_lite/issues"
dev-repo: "git+https://github.com/janestreet/base_lite.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/base_lite/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "base"
  "base_stubs"
  "basement"
  "capsule0"
  "nonempty_list_type"
  "ocaml_intrinsics_kernel"
  "ppx_compare"
  "ppx_enumerate"
  "ppx_hash"
  "ppx_sexp_conv"
  "sexplib0"
  "dune"                    {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Base, with ppx_template and OxCaml syntax erased"
description: "

Base, with ppx_template and OxCaml syntax erased.

In vanilla OCaml this is the same as Base, but in OxCaml this is a pared-down version that
is faster to compile and link.
"
